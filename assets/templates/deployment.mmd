C4Deployment
title Deployment - Development
Deployment_Node(dev, "Developer machine", "Development environment", "Local development") {
  Deployment_Node(runtime, "Node process", "Node.js runtime", "Runs the API") {
    Container(api_dev, "Orders API - instance 1", "Node.js", "Orders API<br/>instance")
  }
  Deployment_Node(postgres, "PostgreSQL server", "Database runtime", "Hosts the logical store") {
    ContainerDb(db_dev, "Orders store - instance 1", "PostgreSQL schema", "Orders store<br/>instance")
  }
}
Rel(api_dev, db_dev, "Writes orders", "PostgreSQL protocol")
UpdateElementStyle(api_dev, $bgColor="#23A2D9", $fontColor="#152332", $borderColor="#0E7DAD")
UpdateElementStyle(db_dev, $bgColor="#23A2D9", $fontColor="#152332", $borderColor="#0E7DAD")
UpdateRelStyle(api_dev, db_dev, $offsetX="-65", $offsetY="-80")
UpdateLayoutConfig($c4ShapeInRow="2", $c4BoundaryInRow="2")


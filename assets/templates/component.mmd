  Component(endpoint, "Order endpoint", "Node.js/HTTP", "Validates requests")
  Component(service, "Order service", "Node.js module", "Coordinates order intake")
  Component(adapter, "Payment adapter", "Node.js/HTTP", "Calls the payment<br/>provider")
}
Rel(web, endpoint, "Submits order", "JSON/HTTPS")
Rel(endpoint, service, "Delegates order")
Rel(service, adapter, "Requests payment")
Rel(adapter, payments, "Authorizes payment", "JSON/HTTPS")
UpdateElementStyle(web, $bgColor="#FFFFFF", $fontColor="#1168BD", $borderColor="#1168BD")

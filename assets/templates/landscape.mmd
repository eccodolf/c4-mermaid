---
config:
  c4:
    c4ShapeMargin: 45
    c4ShapePadding: 10
    diagramMarginX: 15
    diagramMarginY: 15
---
C4Context
title System Landscape - Commerce portfolio (fictional example)
Person(operator, "Warehouse operator", "Manages stock")
Person(customer, "Customer", "Places orders")
Enterprise_Boundary(company, "Commerce company") {
  System(warehouse, "Inventory", "Tracks stock movements")
  System(orders, "Orders", "Accepts and processes<br/>orders")
}
Enterprise_Boundary(provider, "Payment provider") {
  System_Ext(payments, "Payments", "Authorizes payments")
}
Rel(customer, orders, "Places orders using")
Rel(operator, warehouse, "Manages stock using")
Rel(orders, payments, "Requests payment")
UpdateElementStyle(customer, $bgColor="#FFFFFF", $fontColor="#297E06", $borderColor="#297E06")
UpdateElementStyle(orders, $bgColor="#FFFFFF", $fontColor="#1168BD", $borderColor="#1168BD")
UpdateElementStyle(warehouse, $bgColor="#FFFFFF", $fontColor="#1168BD", $borderColor="#1168BD")
UpdateElementStyle(operator, $bgColor="#FFFFFF", $fontColor="#297E06", $borderColor="#297E06")
UpdateElementStyle(payments, $bgColor="#FFFFFF", $fontColor="#BF101D", $borderColor="#BF101D")
UpdateElementStyle(operator, $bgColor="#FFFFFF", $fontColor="#1A849C", $borderColor="#1A849C")
UpdateElementStyle(warehouse, $bgColor="#FFFFFF", $fontColor="#7F0AC5", $borderColor="#7F0AC5")
UpdateRelStyle(customer, orders, $offsetX="15", $offsetY="-20")
UpdateRelStyle(operator, warehouse, $offsetX="15", $offsetY="-20")
UpdateRelStyle(orders, payments, $offsetX="-30", $offsetY="-65")
UpdateLayoutConfig($c4ShapeInRow="2", $c4BoundaryInRow="2")

%% legend: Identity accents: green Customer, teal Warehouse operator, blue Orders, purple Inventory, red Payments.
%% legend: Commerce company and Payment provider frames = organizational groups, not software systems. Person glyph = role. Rectangle = software system. Arrows = named interactions.
%% legend: No system is decomposed in this portfolio view. Native group-frame styling adapts the dotted reference group.
%% legend: Sizes accommodate content and carry no extra architectural meaning. Neutral relationship colors add no extra meaning. Arrowheads indicate the labeled direction.

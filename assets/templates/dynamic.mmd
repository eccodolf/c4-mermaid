C4Dynamic
title Dynamic - Publishing an accepted order (fictional example)
Container(web, "Web UI", "React SPA", "Submits orders")
Container(api, "Orders API", "Node.js", "Accepts orders")
ContainerDb(db, "Orders store", "PostgreSQL schema", "Stores orders")
ContainerQueue(topic, "orders.created", "Kafka topic", "Stores OrderCreated<br/>events")
Rel(web, api, "Submits order", "JSON/HTTPS")
Rel(api, db, "Saves order", "PostgreSQL/TLS")
Rel(api, topic, "Publishes OrderCreated", "Kafka/TLS")
UpdateElementStyle(web, $bgColor="#23A2D9", $fontColor="#152332", $borderColor="#0E7DAD")
UpdateElementStyle(api, $bgColor="#23A2D9", $fontColor="#152332", $borderColor="#0E7DAD")
UpdateElementStyle(db, $bgColor="#23A2D9", $fontColor="#152332", $borderColor="#0E7DAD")
UpdateElementStyle(topic, $bgColor="#23A2D9", $fontColor="#152332", $borderColor="#0E7DAD")
UpdateRelStyle(web, api, $offsetX="-65", $offsetY="-70")
UpdateRelStyle(api, db, $offsetX="-90", $offsetY="-10")
UpdateRelStyle(api, topic, $offsetX="40", $offsetY="5")
UpdateLayoutConfig($c4ShapeInRow="2", $c4BoundaryInRow="1")


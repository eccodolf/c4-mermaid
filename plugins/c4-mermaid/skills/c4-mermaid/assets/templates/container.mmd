---
config:
  c4:
    c4ShapeMargin: 45
    c4ShapePadding: 10
    diagramMarginX: 15
    diagramMarginY: 15
---
C4Container
title Container - Orders (fictional example)
Person(customer, "Customer", "Places orders")
System_Ext(payments, "Payments", "Authorizes payments")
System_Boundary(orders, "Orders") {
  Container(worker, "Order worker", "Node.js", "Starts order fulfillment")
  Container(web, "Web UI", "React SPA", "Order form in<br/>the browser")
  Container(api, "Orders API", "Node.js", "Accepts orders<br/>and requests payment")
  ContainerQueue(topic, "orders.created", "Kafka topic", "Stores OrderCreated<br/>events")
  ContainerDb(db, "Orders store", "PostgreSQL schema", "Stores orders<br/>and payment status")
}
Rel(customer, web, "Places orders using")
Rel(web, api, "Submits orders", "JSON/HTTPS")
Rel(api, db, "Writes orders", "PostgreSQL/TLS")
Rel(api, payments, "Authorizes payments", "JSON/HTTPS")
Rel(api, topic, "Publishes OrderCreated", "Kafka/TLS")
Rel(worker, topic, "Subscribes to OrderCreated", "Kafka/TLS")
UpdateElementStyle(customer, $bgColor="#083F75", $fontColor="#FFFFFF", $borderColor="#06315C")
UpdateElementStyle(payments, $bgColor="#8C8496", $fontColor="#000000", $borderColor="#736782")
UpdateElementStyle(web, $bgColor="#23A2D9", $fontColor="#152332", $borderColor="#0E7DAD")
UpdateElementStyle(api, $bgColor="#23A2D9", $fontColor="#152332", $borderColor="#0E7DAD")
UpdateElementStyle(worker, $bgColor="#23A2D9", $fontColor="#152332", $borderColor="#0E7DAD")
UpdateElementStyle(db, $bgColor="#23A2D9", $fontColor="#152332", $borderColor="#0E7DAD")
UpdateElementStyle(topic, $bgColor="#23A2D9", $fontColor="#152332", $borderColor="#0E7DAD")
UpdateRelStyle(customer, web, $offsetX="-50", $offsetY="-35")
UpdateRelStyle(web, api, $offsetX="-60", $offsetY="-70")
UpdateRelStyle(api, payments, $offsetX="-50", $offsetY="-20")
UpdateRelStyle(api, db, $offsetX="-90", $offsetY="5")
UpdateRelStyle(api, topic, $offsetX="-65", $offsetY="-30")
UpdateRelStyle(worker, topic, $offsetX="15", $offsetY="5")
UpdateLayoutConfig($c4ShapeInRow="3", $c4BoundaryInRow="1")

%% legend: Canonical draw.io C4 roles: dark blue Person, blue System, cyan Container, light cyan Component, muted violet external System. Mermaid glyphs adapt the native assets.
%% legend: Person = actor. Rectangle = application/system with an explicit type. Vertical cylinder = database. Horizontal cylinder = named Kafka topic.
%% legend: Frame = logical system boundary. Native Mermaid uses a neutral dashed scope frame; the exact native companion preserves the canonical rounded frame and bottom label.
%% legend: Arrows describe dependencies through their action/protocol labels. A dashed line does not itself mean async.
%% legend: Sizes accommodate content and carry no extra architectural meaning. Neutral relationship colors add no extra meaning. Arrowheads indicate the labeled direction.



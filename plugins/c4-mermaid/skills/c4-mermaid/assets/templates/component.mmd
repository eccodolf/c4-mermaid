C4Component
title Component - Orders API: payment path (fictional example)
Container(web, "Web UI", "React SPA", "Submits orders")
System_Ext(payments, "Payments", "Authorizes payments")
Container_Boundary(api, "Orders API - Node.js") {
  Component(endpoint, "Order endpoint", "Node.js/HTTP", "Validates requests")
  Component(service, "Order service", "Node.js module", "Coordinates order intake")
  Component(adapter, "Payment adapter", "Node.js/HTTP", "Calls the payment<br/>provider")
}
Rel(web, endpoint, "Submits order", "JSON/HTTPS")
Rel(endpoint, service, "Delegates order")
Rel(service, adapter, "Requests payment")
Rel(adapter, payments, "Authorizes payment", "JSON/HTTPS")
UpdateElementStyle(web, $bgColor="#23A2D9", $fontColor="#152332", $borderColor="#0E7DAD")
UpdateElementStyle(payments, $bgColor="#8C8496", $fontColor="#000000", $borderColor="#736782")
UpdateElementStyle(endpoint, $bgColor="#63BEF2", $fontColor="#152332", $borderColor="#2086C9")
UpdateElementStyle(service, $bgColor="#63BEF2", $fontColor="#152332", $borderColor="#2086C9")
UpdateElementStyle(adapter, $bgColor="#63BEF2", $fontColor="#152332", $borderColor="#2086C9")
UpdateRelStyle(web, endpoint, $offsetX="-65", $offsetY="-25")
UpdateRelStyle(endpoint, service, $offsetX="-55", $offsetY="-55")
UpdateRelStyle(service, adapter, $offsetX="-65", $offsetY="-55")
UpdateRelStyle(adapter, payments, $offsetX="15", $offsetY="5")
UpdateLayoutConfig($c4ShapeInRow="3", $c4BoundaryInRow="1")


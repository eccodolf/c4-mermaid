nd" c4Type="annotation"><mxCell style="shape=table;startSize=30;container=1;collapsible=0;childLayout=tableLayout;fontSize=16;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#404040;fontStyle=1;spacingLeft=6;spacing=0;" parent="1" vertex="1"><mxGeometry x="20" y="1296" width="360" height="60" as="geometry" /></mxCell></object><mxCell id="meta_legend_row_0" parent="meta_legend" value="" vertex="1" style="shape=tableRow;horizontal=0;startSize=0;strokeColor=none;fillColor=none;collapsible=0;"><mxGeometry y="30" width="360" height="30" as="geometry" /></mxCell><mxCell id="meta_legend_row_0_key" parent="meta_legend_row_0" vertex="1" value="Container" c4LegendRole="container" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=none;fillColor=#23A2D9;fontColor=#152332;top=0;left=0;bottom=0;right=0;align=left;spacingLeft=10;fontSize=13;"><mxGeometry width="360" height="30" as="geometry" /></mxCell><object id="meta_notation" label="Сплошные рамки — узлы размещения; голубые блоки —&lt;br&gt;экземпляры контейнеров; цилиндры — данные. Стрелки&lt;br&gt;показывают направленные взаимодействия.&lt;br&gt;Размещение сервера основано на локальных скриптах&lt;br&gt;и не проверено вживую. HTTPS — защищённый HTTP; JSON —&lt;br&gt;формат данных; API — интерфейс; PWA — веб-приложение." c4Type="annotation"><mxCell style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=13;fontColor=#404040;fillColor=none;strokeColor=none;" parent="1" vertex="1"><mxGeometry x="410" y="1326" width="680" height="120" as="geometry" /></mxCell></object><object id="meta_title" label="Deployment — GameSessionMonitor: описанное размещение" c4Type="annotation" c4View="deployment" c4ExpectedExternalSystems="[]"><mxCell style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=20;fontColor=#404040;strokeColor=none;fillColor=none;" parent="1" vertex="1"><mxGeometry x="20" y